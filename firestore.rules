rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuth() { return request.auth != null; }
    function isDispatcher() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dispatcher';
    }
    function isResponder() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'responder';
    }
    function isReporter() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'reporter';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && (request.auth.uid == userId || isDispatcher());
    }

    // Incidents collection
    match /incidents/{incidentId} {
      allow create: if isAuth();
      allow read: if isAuth() && (
        isDispatcher() ||
        (resource.data.reporterId == request.auth.uid) ||
        (resource.data.responderId == request.auth.uid)
      );
      allow update: if isAuth() && (
        isDispatcher() ||
        (isResponder() && resource.data.responderId == request.auth.uid)
      );
      allow delete: if false;
    }

    // Status logs
    match /statusLogs/{logId} {
      allow read, write: if isAuth();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Deny everything else
    match /{document=**} { allow read, write: if false; }
  }
}
